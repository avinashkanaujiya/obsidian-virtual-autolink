{
	"name": "obsidian-virtual-autolink",
	"version": "3.1.7",
	"description": "Automatically creates virtual links for text within your notes that match the titles or aliases of other notes in your vault.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"lint": "eslint . --max-warnings 0",
		"lint:css": "stylelint styles.css --max-warnings 0",
		"lint:fix": "npm run lint -- --fix",
		"check": "node check.mjs"
	},
	"keywords": [],
	"author": "Avinash Kanaujiya",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@codemirror/language": "6.10.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@flatten-js/interval-tree": "1.1.3",
		"@types/jest": "^29.5.12",
		"@types/node": "16.11.6",
		"esbuild": "0.14.47",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "14.0.0",
		"jest": "^29.7.0",
		"obsidian": "1.14.4",
		"stylelint": "17.16.0",
		"ts-jest": "^29.2.5",
		"tslib": "2.4.0",
		"typescript": "5.4.5",
		"typescript-eslint": "8.72.1"
	}
}
